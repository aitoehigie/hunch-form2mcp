{
  "name": "hunch-form2mcp",
  "version": "0.1.3",
  "description": "Convert website HTML forms into MCP tool definitions and Hunch-compatible HTML attributes",
  "main": "dist/index.js",
  "bin": {
    "hunch-form2mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "commander": "^11.0.0",
    "linkedom": "^0.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "vitest": "^1.6.0"
  }
}
